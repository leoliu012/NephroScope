# Backend
AGH_DATA_ROOT=/data/AGH_APP
AGH_ANN_ROOT=/data/agh_annotations
AGH_CACHE_ROOT=/data/agh_cache
AGH_HOST=127.0.0.1
AGH_PORT=5055

# Watcher / sync-agent
AGH_NAS_ROOT=T:\Ha\AGH_APP
AGH_REMOTE_HOST=agh-upload@example.org
AGH_REMOTE_DIR=/data/AGH_APP
AGH_SSH_KEY_PATH=C:\Users\you\.ssh\agh-upload.pem
AGH_KNOWN_HOSTS=C:\Users\you\.ssh\known_hosts
AGH_STRICT_HOST_KEY_CHECKING=yes
AGH_POLL_INTERVAL=30
AGH_DEBOUNCE_SECONDS=15
AGH_RECONCILE_INTERVAL=300

# App deploy
AGH_DEPLOY_REMOTE=ubuntu@example.org
AGH_BASIC_AUTH_USER=agh-lab
AGH_BASIC_AUTH_PASSWORD=change-me-before-deploy
