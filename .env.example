# Backend
AGH_DATA_ROOT=/data/AGH_APP
AGH_ANN_ROOT=/data/agh_annotations
AGH_HOST=127.0.0.1
AGH_PORT=5055
AGH_API_TARGET=http://localhost:5055
AGH_RAW_CHANNEL_CACHE_MB=512
AGH_VERSIONED_RESPONSE_CACHE_SECONDS=604800
AGH_ALLOWED_HOSTS=windows-zhaovr,windows-zhaovr.tailefdc25.ts.net,.ts.net

# Authentication / sessions
# Accounts live in a JSON store managed by backend/manage_users.py.
# Passwords are salted PBKDF2 hashes; there is NO shared password.
AGH_STATE_DIR=/home/ubuntu/agh-viewer/state       # holds users.json, sessions/, login_attempts.json
# AGH_USERS_FILE=/home/ubuntu/agh-viewer/state/users.json   # override AGH_STATE_DIR default
# AGH_SESSION_DIR=/home/ubuntu/agh-viewer/state/sessions
AGH_AUDIT_LOG_FILE=/home/ubuntu/agh-viewer/state/audit_events.jsonl
AGH_AUTH_REQUIRED=1
# Only for isolated local development. Never set this when exposing the app
# through ngrok, Tailscale, Apache, or any other network tunnel/proxy.
# AGH_AUTH_REQUIRED=0
# AGH_ALLOW_INSECURE_AUTH_BYPASS=I_UNDERSTAND_THIS_EXPOSES_DATA
AGH_SESSION_TTL_SECONDS=43200                     # absolute session lifetime (12h)
AGH_SESSION_IDLE_SECONDS=28800                    # idle timeout (8h); 0 disables
AGH_COOKIE_SECURE=auto                            # auto | true | false. "auto" = secure when the request is HTTPS
AGH_ALLOW_BASIC_AUTH=0                            # opt-in HTTP Basic (against the same store) for automation only
AGH_LOGIN_MAX_ATTEMPTS=8                          # failures per IP/username before lockout
AGH_LOGIN_WINDOW_SECONDS=900
AGH_LOGIN_LOCKOUT_SECONDS=900

# Remote-mounted image-cache sync (remote is authoritative; the API reads
# only AGH_DATA_ROOT).  For a Windows share mounted in WSL, use /mnt/<drive>/…
# rather than a Windows drive-letter path.  Store this same configuration in
# /etc/agh-viewer/image-sync.env on the production host.
# AGH_REMOTE_DATA_ROOT=/mnt/r/AGH_APP
# AGH_SYNC_STATE_DIR=/home/ubuntu/agh-viewer/state/localdata-sync
AGH_SYNC_INTERVAL_SECONDS=86400
AGH_SYNC_POLL_SECONDS=15
AGH_SYNC_FINGERPRINT_MB=4

# App deploy
AGH_DEPLOY_REMOTE=ubuntu@example.org
