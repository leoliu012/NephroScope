[Unit]
Description=AGH MagnifySeg Analysis Worker
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/agh-viewer/backend
Environment="AGH_DATA_ROOT=/data/AGH_APP"
Environment="AGH_ANN_ROOT=/data/agh_annotations"
Environment="AGH_CACHE_ROOT=/data/agh_cache"
Environment="AGH_ANALYSIS_ROOT=/data/agh_analysis"
Environment="AGH_MODEL_ROOT=/data/agh_models"
Environment="AGH_ANALYSIS_DB=/data/agh_analysis/jobs.sqlite3"
Environment="PATH=/home/ubuntu/agh-viewer/inference-venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/agh-viewer/inference-venv/bin/python /home/ubuntu/agh-viewer/backend/worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
